{
	"name": "@urixoft/urx-cms-package",
	"version": "0.4.2",
	"description": "Lightweight SQLite-backed CMS package for Urixoft SvelteKit projects (node:sqlite, no Docker)",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "https://github.com/patabudlong/urx-cms-package.git"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"bin": {
		"urx-cms": "./bin/urx-cms.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./categories": {
			"types": "./dist/categories/repository.d.ts",
			"import": "./dist/categories/repository.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit/index.d.ts",
			"import": "./dist/sveltekit/index.js"
		}
	},
	"files": [
		"bin",
		"dist",
		"sql",
		"templates",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"prepare": "tsc",
		"check": "tsc --noEmit"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"@tiptap/core": "^2.11.5",
		"@tiptap/extension-link": "^2.11.5",
		"@tiptap/starter-kit": "^2.11.5",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.888.0",
		"bcryptjs": "^3.0.2"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^24",
		"svelte": "^5.56.1",
		"typescript": "^6.0.3"
	},
	"keywords": [
		"urixoft",
		"sveltekit",
		"cms",
		"sqlite"
	]
}
